# Contributor: Bolt J Woofson <bolt@boop.no>
# Maintainer: Bolt J Woofson <bolt@boop.no>
pkgname=brum
pkgver=0.8.2
pkgrel=0
pkgdesc="Multi-Pane Web Environment (File Commander/Manager) - By Woofson"
url="https://github.com/Woofson/brum"
arch="x86_64 aarch64"
license="MIT"
depends="ca-certificates libssh2 sqlite-libs"
makedepends="cargo rust openssl-dev libssh2-dev sqlite-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/Woofson/brum/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
    cargo build --release --locked
}

check() {
    cargo test --release
}

package() {
    install -Dm755 target/release/brum "$pkgdir"/usr/local/bin/brum
    install -Dm644 config.toml "$pkgdir"/etc/brum/config.toml
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
    install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}

