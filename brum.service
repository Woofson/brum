[Unit]
Description=Brum - Multi-Pane Web Environment (File Commander/Manager)
After=network.target network-online.target
Wants=network-online.target
# Give up after 10 failed starts in 10 minutes (missing program, broken install) instead of
# retrying every 5 seconds forever. To start it again sooner:
#   systemctl reset-failed brum && systemctl start brum
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=-/etc/brum
ExecStart=/usr/bin/brum --server
Restart=always
RestartSec=5
EnvironmentFile=-/etc/brum/brum.env
LimitNOFILE=65536
# Locked down by design: no sudo/su in Brum's terminal, /usr and /boot read-only.
# To lift this on one machine, use "sudo systemctl edit brum" (not this file); see
# "Admin Rights in the Terminal" in the Settings and Configuration manual.
NoNewPrivileges=true
ProtectSystem=true
# "-": a missing /etc/brum does not stop Brum from starting (it has built-in defaults)
ReadWritePaths=-/etc/brum
# Data in /var/lib/brum, logs in /var/log/brum, unpacked disk images in /var/cache/brum
# (created by systemd); nothing in root's home folder
StateDirectory=brum
StateDirectoryMode=0700
LogsDirectory=brum
LogsDirectoryMode=0750
CacheDirectory=brum
CacheDirectoryMode=0700
# No PrivateTmp on purpose: Brum's terminal and panels see the real /tmp, so files there and
# tmux/screen sessions started in a Brum terminal survive a Brum restart (#201).

[Install]
WantedBy=multi-user.target
